import {
  "open_document/core/failure",
  "open_document/core/archive",
  "open_document/formats/docx" @model,
  "open_document/layout",
  "open_document/bridge/common",
  "moonbitlang/core/json",
  "open_document/formats/pdf",
}

options(
  link: {
    "wasm-gc": {
      "exports": [
        "abi_version",
        "new_context:docx_new",
        "call_wire:docx_call",
        "take_output:docx_output",
        "add_font:docx_add_font",
        "close:docx_close",
      ],
      "use-js-builtin-string": true,
      "imported-string-constants": "_",
    },
  },
)
