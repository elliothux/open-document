import {
  "open_document/core/failure",
  "open_document/core/archive",
  "open_document/core/opc",
  "open_document/formats/pptx" @model,
  "open_document/layout",
  "open_document/bridge/common",
  "moonbitlang/core/json",
  "open_document/formats/pdf",
}

options(
  link: {
    "wasm-gc": {
      "exports": [
        "abi_version",
        "new_context:pptx_new",
        "call_wire:pptx_call",
        "take_output:pptx_output",
        "add_font:pptx_add_font",
        "close:pptx_close",
      ],
      "use-js-builtin-string": true,
      "imported-string-constants": "_",
    },
  },
)
