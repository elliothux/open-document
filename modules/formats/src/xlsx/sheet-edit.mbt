///|
pub(all) enum SheetEdit {
  Add
  Copy
  Delete
  Move(Int32)
  Visibility(String)
  Rename(String)
  RowHeight(Int32, Int32, Double)
  ColumnWidth(Int32, Int32, Double)
  GroupOutline(String, Int32, Int32, Bool)
  CollapseOutline(String, Int32, Int32, Int32, Bool)
  ClearOutline(String)
  OutlineSummary(String, Bool)
  RenameTable(Int32, String)
  CreateTable(String, String)
  ResizeTable(Int32, String)
  TableColumnFormula(Int32, Int32, String?)
  TableTotals(Int32, Bool)
  TableStyle(Int32, TableStyleSettings)
  TableStyleDefinition(String?, String, Array[TableStyleElement])
  DeleteTableStyle(String, String?)
  TableColumnTotal(Int32, Int32, TableTotal)
  TableFilter(Int32, Array[FilterColumn])
  TableFilterClear(Int32)
  TableFilterRemove(Int32)
  TableFilterReapply(Int32)
  RenameTableColumn(Int32, Int32, String)
  InsertRows(Int32, Int32)
  DeleteRows(Int32, Int32)
  InsertColumns(Int32, Int32)
  DeleteColumns(Int32, Int32)
  InsertCells(String, String)
  DeleteCells(String, String)
  MoveCells(String, String, String)
  Fill(String, String)
  Series(SeriesMode, String, String, String)
  Sort(String, SortSettings)
  RemoveDuplicates(DuplicateSettings, Int32)
  TextToColumns(TextColumnSettings, Int32, Bool)
  Consolidate(ConsolidateSettings, Int32, Bool)
  CreateSubtotals(SubtotalSettings, Int32)
  SetFilter(FilterSettings)
  ClearFilter
  RemoveFilter
  ReapplyFilter
  Merge(String, Bool)
  Unmerge(String)
  Freeze(Int32, Int32)
  View(ViewSettings)
  SetName(NameSettings)
  DeleteName(String, String?)
  SelectName(String, String?)
  PageSetup(PrintSetup)
  PrintRange(PrintRange)
  HeaderFooter(HeaderFooter)
  Validation(String, DataValidation?)
  ValidationValue(Int32, Int32)
  ConditionalRule(String, Int32?, ConditionalFormat?, Int32)
  ConditionalPriority(Int32, Int32, Int32)
  Sparkline(String, String?, String)
  Hyperlink(String, String?)
  OpenHyperlink(String, Int32)
  Note(String, String?, String)
  DrawingOrder(String, String)
  DuplicateDrawing(String)
  MoveDrawing(String, String)
  Protection(Bool, String, Bytes)
  WorkbookProtection(Bool, String, Bytes)
}
