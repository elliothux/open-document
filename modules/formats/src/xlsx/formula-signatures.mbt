///|
#derive(ToJson)
priv struct FormulaSignature {
  name : String
  parameters : Array[String]
}

///|
let formula_signatures : Array[FormulaSignature] = [
  ("ABS", "number"),
  ("ACOS", "number"),
  ("ACOSH", "number"),
  ("AND", "logical1;[logical2, …]"),
  ("ASIN", "number"),
