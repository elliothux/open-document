  ("SIN", "number"),
  ("SINH", "number"),
  ("SMALL", "array;k"),
  ("SQRT", "number"),
  ("STDEV", "number1;[number2, …]"),
  ("STDEV.P", "number1;[number2, …]"),
  ("STDEV.S", "number1;[number2, …]"),
  ("STDEVP", "number1;[number2, …]"),
