{
  "name": "@open-document/ui",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src",
    "dist",
    "NOTICE",
    "UNICODE-LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./controls": {
      "types": "./dist/types/controls.d.ts",
      "default": "./dist/controls.js"
    },
    "./panels": {
      "types": "./dist/types/panels.d.ts",
      "default": "./dist/panels.js"
    },
    "./chart-fields": {
      "types": "./dist/types/chart-fields.d.ts",
      "default": "./dist/chart-fields.js"
    },
    "./word-art": {
      "types": "./dist/types/word-art.d.ts",
      "default": "./dist/word-art.js"
    },
    "./icons": {
      "types": "./dist/types/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./shell": {
      "types": "./dist/types/shell.d.ts",
      "default": "./dist/shell.js"
    }
  },
  "dependencies": {
    "@open-document/wasm": "0.0.1",
    "@open-document/web-core": "0.0.1",
    "@base-ui/react": "1.9.0"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
