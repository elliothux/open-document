{
  "name": "@open-document/wasm",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src",
    "dist",
    "NOTICE",
    "UNICODE-LICENSE"
  ],
  "exports": {
    "./pptx": {
      "types": "./src/pptx.ts",
      "default": "./dist/pptx.js"
    },
    "./xlsx": {
      "types": "./src/xlsx.ts",
      "default": "./dist/xlsx.js"
    },
    "./drawing": {
      "types": "./src/drawing.ts",
      "default": "./dist/drawing.js"
    },
    "./preview": {
      "types": "./src/preview.ts",
      "default": "./dist/preview.js"
    },
    "./foundation": {
      "types": "./src/foundation.ts",
      "default": "./dist/foundation.js"
    },
    "./engine": {
      "types": "./src/engine.ts",
      "default": "./dist/engine.js"
    },
    "./engine.wasm": "./dist/engine.wasm"
  },
  "scripts": {
    "build": "bun build src/engine.ts src/foundation.ts src/preview.ts src/drawing.ts src/validation.ts src/session.ts src/xlsx.ts src/pptx.ts --no-bundle --target browser --outdir dist && cp ../../LICENSE dist/LICENSE",
    "typecheck": "tsc --project tsconfig.json"
  }
}
