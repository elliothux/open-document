{
  "name": "@open-document/wasm",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src",
    "dist",
    "NOTICE",
    "UNICODE-LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/*.js"
    },
    "./abi/*": {
      "types": "./dist/types/abi/*.d.ts",
      "default": "./dist/abi/*.js"
    },
    "./engine.wasm": "./dist/engine.wasm",
    "./engine-source": {
      "types": "./dist/engine-source.d.ts",
      "default": "./dist/engine-source.js"
    }
  },
  "dependencies": {},
  "scripts": {
    "typecheck": "tsc --project tsconfig.json"
  }
}
