{
  "name": "@open-document/web",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src",
    "dist"
  ],
  "exports": {
    "./preview": {
      "types": "./src/preview.ts",
      "default": "./dist/preview.js"
    },
    "./foundation": {
      "types": "./src/foundation.ts",
      "default": "./dist/foundation.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./worker": "./dist/worker.js"
  },
  "dependencies": {
    "@open-document/wasm": "workspace:*"
  },
  "scripts": {
    "build": "bun build src/client.ts src/worker.ts src/foundation.ts src/preview.ts --target browser --outdir dist && cp ../../LICENSE dist/LICENSE",
    "typecheck": "tsc --project tsconfig.json"
  }
}
