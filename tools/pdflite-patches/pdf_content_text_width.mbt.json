        "///|",
        "fn pdf_content_cid_vertical_width_lookup(",
        "  widths : ArrayView[(Int, PdfCIDVerticalWidth)],",
        "  charcode : Int,",
        ") -> PdfCIDVerticalWidth? {",
        "  for entry in widths {",
        "    guard @core.sdk_allow(1) else { return None }",
        "    if entry.0 == charcode {",
        "      break Some(entry.1)",
        "    }",
        "  } nobreak {",
        "    None",
        "  }",
        "}",
        "",
        "///|",
        "fn pdf_content_cid_default_width2(",
        "  widths : ArrayView[Double],",
        ") -> (Double, Double) {",
        "  if widths.length() >= 2 {",
        "    (widths[0], widths[1])",
        "  } else {",
        "    (880.0, -1000.0)",
        "  }",
        "}",
        "",
        "///|",
        "fn pdf_content_cid_horizontal_width(",
        "  font : PdfCIDKeyedFont,",
        "  charcode : Int,",
        ") -> Double {",
        "  pdf_content_cid_width_lookup(font.composite.cid_widths, charcode).unwrap_or(",
        "    font.composite.cid_default_width,",
        "  )",
        "}",
        "",
        "///|",
        "fn pdf_content_cid_width_of_charcode(",
        "  font : PdfCIDKeyedFont,",
        "  charcode : Int,",
        ") -> (Double, Double, Double) {",
        "  if PdfFontCIDKeyed(font).content_is_vertical() {",
        "    match",
        "      pdf_content_cid_vertical_width_lookup(",
        "        font.composite.cid_widths2,",
        "        charcode,",
        "      ) {",
        "      Some(width) => (width.width, width.vx, width.vy)",
        "      None => {",
        "        let (vy, advance) = pdf_content_cid_default_width2(",
        "          font.composite.cid_default_width2,",
        "        )",
        "        (advance, pdf_content_cid_horizontal_width(font, charcode) / 2.0, vy)",
        "      }",
        "    }",
        "  } else {",
        "    (pdf_content_cid_horizontal_width(font, charcode), 0.0, 0.0)"
      ]
    ]
  ]
