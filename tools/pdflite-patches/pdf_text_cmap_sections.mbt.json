        "///|",
        "fn pdf_text_push_cmap_integer_array_entries(",
        "  entries : Array[(Int, Int)],",
        "  line : BytesView,",
        ") -> Unit {",
        "  for index = 0; index < line.length(); {",
        "    guard pdf_text_parse_cmap_hex_group_at(line, index) is Some((source, a)) &&",
        "      pdf_text_parse_cmap_hex_group_at(line, a) is Some((stop, b)) else { break }",
        "    let start = pdf_text_skip_cmap_whitespace(line, b)",
        "    if start >= line.length() || line[start] != b'[' {",
        "      if pdf_text_cmap_byte_destination_at(line, start) is Some((_, after)) {",
        "        continue after",
        "      }",
        "      break",
        "    }",
        "    guard pdf_text_index_of_byte(line, 93, start + 1) is Some(close) else { break }",
        "    if pdf_text_parse_cmap_ascii_int_at(line, start + 1) is None {",
        "      continue close + 1",
        "    }",
        "    guard pdf_text_bytes_to_int(source) is Some(first) &&",
        "      pdf_text_bytes_to_int(stop) is Some(last) &&",
        "      first <= last && @core.sdk_cmap_range(first, last) else { return }",
        "    let values : Array[Int] = []",
        "    let mut cursor = start + 1",
        "    let mut valid = true",
        "    while pdf_text_skip_cmap_whitespace(line, cursor) < close {",
        "      guard pdf_text_parse_cmap_ascii_int_at(line, cursor) is Some((value, after)) &&",
        "        value >= 0 && values.length() <= last - first && after <= close else {",
        "        valid = false",
        "        break",
        "      }",
        "      values.push(value)",
        "      cursor = after",
        "    }",
        "    if valid && values.length() == last - first + 1 {",
        "      for offset, value in values { entries.push((first + offset, value)) }",
        "    }",
        "    continue close + 1",
        "  }",
        "}",
        ""
      ]
