      7,
      17,
      [
        "  if ![1, 2, 4, 8, 16].contains(bits_per_component) {",
        "    raise PredictorNotSupported(2)",
        "  }",
        "  let scanline_width = pdf_predictor_scanline_width(",
        "    colors, bits_per_component, columns,",
        "  )",
        "  guard data.length() % scanline_width == 0 else { raise PredictorNotSupported(2) }",
        "  @core.sdk_decoded(data.length())",
        "  let output : Array[Byte] = [ for byte in data => byte ]",
        "  for line in 0..<(data.length() / scanline_width) {",
        "    let line_start = line * scanline_width",
        "    let previous = Array::make(colors, 0)",
        "    for sample in 0..<(colors * columns) {",
        "      @core.sdk_check(1)",
        "      let bit = sample * bits_per_component",
        "      let mut value = 0",
        "      for shift in 0..<bits_per_component {",
        "        let index = line_start + (bit + shift) / 8",
        "        value = (value << 1) | ((data[index].to_int() >> (7 - (bit + shift) % 8)) & 1)",
        "      }",
        "      value = (value + previous[sample % colors]) & ((1 << bits_per_component) - 1)",
        "      previous[sample % colors] = value",
        "      for shift in 0..<bits_per_component {",
        "        let index = line_start + (bit + shift) / 8",
        "        let mask = 1 << (7 - (bit + shift) % 8)",
        "        output[index] = ((output[index].to_int() & (255 ^ mask)) | (((value >> (bits_per_component - 1 - shift)) & 1) * mask)).to_byte()",
        "      }"
      ]
    ]
  ]
}
