      [
        "///|",
        "fn pdf_text_cmap_byte_destination_at(",
        "  line : BytesView,",
        "  index : Int,",
        ") -> (@core.PdfBytes, Int)? {",
        "  if pdf_text_parse_cmap_hex_group_at(line, index) is Some(value) {",
        "    return Some(value)",
        "  }",
        "  guard pdf_text_parse_cmap_ascii_int_at(line, index) is Some((value, stop)) &&",
        "    value >= 0 && value <= 255 else { return None }",
        "  if stop < line.length() &&",
        "    !@core.pdf_is_whitespace_byte(line[stop].to_int()) &&",
        "    line[stop] != b'<' {",
        "    return None",
        "  }",
        "  Some((Bytes::from_array([value.to_byte()]), stop))",
        "}",
        ""
      ]
    ]
