      [
        "///|",
        "/// Decrypted Type 1 programs evaluated by the existing bounded charstring engine.",
        "pub struct SdkType1Font {",
        "  glyphs : Map[String, Bytes]",
        "  subrs : Map[Int, Bytes]",
        "  matrix : Array[Double]",
        "  paths : Map[String, Array[SdkCffSegment]]",
        "}",
        "",
        "///|",
        "pub fn SdkType1Font::new(",
        "  glyphs : Map[String, Bytes],",
        "  subrs : Map[Int, Bytes],",
        "  matrix : Array[Double],",
        ") -> SdkType1Font raise @core.PdfError {",
        "  guard @core.sdk_active() &&",
        "    glyphs.length() > 0 &&",
        "    glyphs.length() <= 65535 &&",
        "    subrs.length() <= 65535 &&",
        "    matrix.length() == 6 &&",
        "    matrix.all(v => !v.is_nan() && !v.is_inf() && v.abs() <= 1000000) &&",
        "    matrix[0] * matrix[3] - matrix[1] * matrix[2] != 0 else {",
        "    raise @core.PdfError::HardError(\"Invalid Type 1 font geometry or budget\")",
        "  }",
        "  { glyphs, subrs, matrix, paths: Map([]), }",
        "}",
        "",
        "///|",
        "impl @cffparser.CharstringContext for SdkType1Font with fn kind(_) {",
        "  @cffparser.Type1",
        "}",
        "",
        "///|",
        "impl @cffparser.CharstringContext for SdkType1Font with fn global_subr(_, _) {",
        "  raise @cffparser.MissingSubroutines",
        "}",
        "",
        "///|",
        "impl @cffparser.CharstringContext for SdkType1Font with fn subr(self, index) {",
        "  guard self.subrs.get(index) is Some(bytes) else {",
        "    raise @cffparser.MissingSubroutines",
        "  }",
        "  bytes[:]",
        "}",
        "",
        "///|",
        "impl @cffparser.CharstringContext for SdkType1Font with fn weight_vector(_) {",
        "  []",
        "}",
        "",
        "///|",
        "impl @cffparser.CharstringContext for SdkType1Font with fn seac_components(",
        "  self,",
        "  base,",
        "  accent,",
        ") {",
        "  guard base >= 0 && base <= 255 && accent >= 0 && accent <= 255 else {",
        "    raise @cffparser.InvalidSeacCode(base)",
        "  }",
        "  let encoding : @cffparser.PredefinedEncoding = @cffparser.Standard",
        "  guard self.glyphs.get(encoding.name(base)) is Some(base_string) &&",
        "    self.glyphs.get(encoding.name(accent)) is Some(accent_string) else {",
        "    raise @cffparser.InvalidSeacCode(accent)",
        "  }",
        "  (base_string[:], accent_string[:])",
        "}",
        "",
        "///|",
        "pub fn SdkType1Font::outline(",
        "  self : SdkType1Font,",
        "  name : String,",
        ") -> Array[SdkCffSegment] raise @core.PdfError {",
        "  guard @core.sdk_active() else {",
        "    raise @core.PdfError::HardError(\"Type 1 reads require an active SDK budget\")",
        "  }",
        "  let name = if name.is_empty() { \".notdef\" } else { name }",
        "  if self.paths.get(name) is Some(path) {",
        "    return path",
        "  }",
        "  guard self.glyphs.get(name) is Some(program) else {",
        "    raise @core.PdfError::HardError(\"Missing embedded Type 1 glyph: \" + name)",
        "  }",
        "  guard !program.is_empty() else {",
        "    raise @core.PdfError::HardError(\"Empty Type 1 charstring\")",
        "  }",
        "  let pen : SdkCffPen = { segments: [], upem: 1, valid: true, }",
        "  let sink = @cffparser.PenSink::new(pen)",
        "  ignore(@cffparser.evaluate(self, program[:], sink)) catch {",
        "    error => {",
        "      @core.sdk_check(0)",
        "      raise @core.PdfError::HardError(",
        "        \"Invalid Type 1 glyph: \" + error.to_string(),",
        "      )",
        "    }",
        "  }",
        "  guard pen.valid else {",
        "    raise @core.PdfError::HardError(",
        "      \"Type 1 outline exceeds coordinate or segment limit\",",
        "    )",
        "  }",
        "  fn point(x : Double, y : Double) -> (Double, Double) raise @core.PdfError {",
        "    let m = self.matrix",
        "    let xx = m[0] * x + m[2] * y + m[4]",
        "    let yy = m[1] * x + m[3] * y + m[5]",
        "    guard !xx.is_nan() &&",
        "      !xx.is_inf() &&",
        "      !yy.is_nan() &&",
        "      !yy.is_inf() &&",
        "      xx.abs() <= 1000000 &&",
        "      yy.abs() <= 1000000 else {",
        "      raise @core.PdfError::HardError(\"Type 1 outline exceeds coordinate limit\")",
        "    }",
        "    (xx, yy)",
        "  }",
        "  for i, segment in pen.segments {",
        "    pen.segments[i] = match segment {",
        "      CffMove(x, y) => {",
        "        let (x, y) = point(x, y)",
        "        CffMove(x, y)",
        "      }",
        "      CffLine(x, y) => {",
        "        let (x, y) = point(x, y)",
        "        CffLine(x, y)",
        "      }",
        "      CffCubic(a, b, c, d, x, y) => {",
        "        let (a, b) = point(a, b)",
        "        let (c, d) = point(c, d)",
        "        let (x, y) = point(x, y)",
        "        CffCubic(a, b, c, d, x, y)",
        "      }",
        "      CffClose => CffClose",
        "    }",
        "  }",
        "  @core.sdk_decoded(pen.segments.length() * 48)",
        "  self.paths[name] = pen.segments",
        "  pen.segments",
        "}"
      ]
    ]
  ]
}
