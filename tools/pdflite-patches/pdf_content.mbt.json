        "pub fn pdf_parse_content_ops_with_ranges(",
        "  data : BytesView,",
        ") -> (Array[@content.PdfContentOp], Array[(Int, Int)]?) raise @core.PdfError {",
        "  let ranges : Array[(Int, Int)] = []",
        "  let ops = pdf_parse_content_ops_from_view_with_context(",
        "    data,",
        "    pdf_content_parse_context(None),",
        "    ranges=Some(ranges),",
        "  )",
        "  (ops, if ranges.length() == ops.length() { Some(ranges) } else { None })",
        "}",
