      [
        "///|",
        "// Native PDF decimals retain their accumulation order before device-grid rounding.",
        "fn pdf_content_native_decimal(view : BytesView) -> Double? {",
        "  let mut negative = false",
        "  let mut fractional = false",
        "  let mut digits = false",
        "  let mut scale = 0.1",
        "  let mut value = 0.0",
        "  for i in 0..<view.length() {",
        "    let byte = view[i].to_int()",
        "    if i == 0 && (byte == 43 || byte == 45) {",
        "      negative = byte == 45",
        "    } else if byte == 46 && !fractional {",
        "      fractional = true",
        "    } else if byte >= 48 && byte <= 57 {",
        "      digits = true",
        "      let digit = (byte - 48).to_double()",
        "      if fractional {",
        "        value += scale * digit",
        "        scale *= 0.1",
        "      } else {",
        "        value = value * 10.0 + digit",
        "      }",
        "    } else {",
        "      return None",
        "    }",
        "  }",
        "  if !fractional || !digits || value.is_nan() || value.is_inf() { None } else { Some(if negative { -value } else { value }) }",
        "}",
        "",
        "///|",
        "fn pdf_content_read_token(cursor : @core.ByteCursor) -> @syntax.PdfLexeme raise @core.PdfError {",
        "  @syntax.pdf_cursor_drop_whitespace(cursor)",
        "  if !@syntax.pdf_is_number_start_byte(cursor.peek_byte()) {",
        "    return @syntax.pdf_cursor_lex_token(cursor)",
        "  }",
        "  @core.sdk_check(1)",
        "  let view = @syntax.pdf_cursor_read_regular_token_view(cursor)",
        "  match @syntax.pdf_number_view_int(view) {",
        "    Some(value) => @syntax.LexInt(value)",
        "    None => match pdf_content_native_decimal(view) {",
        "      Some(value) => @syntax.LexReal(value)",
        "      None => @syntax.pdf_lex_single_view(view)",
        "    }",
        "  }",
        "}",
        ""
      ]
    ],
    [102, 1, ["    let token = pdf_content_read_token(cursor)"]],
    [120, 1, ["  let token = pdf_content_read_token(cursor)"]]
  ],
  "source": "ONLYOFFICE core3250a848ee4ef20c2fb8c38dc86350ec579124b8 PdfFile/lib/xpdf/Lexer.cc:204-225; Poppler26.05.0 Lexer.cc:268-283. Native decimal accumulation applies only to content operands. Source dictionaries retain the unchanged object lexer and numeric identity."
