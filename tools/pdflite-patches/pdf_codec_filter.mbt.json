        "  }",
        "}",
        "",
        "///|",
        "/// Decode owned bytes with a single PDF filter name.",
        "///",
        "/// Identity and Flate paths avoid an extra copy where possible.",
        "pub fn pdf_decode_filter_bytes(",
        "  filter : @core.PdfName,",
        "  data : @core.PdfBytes,",
        ") -> @core.PdfBytes raise @core.PdfError {",
        "  if @core.sdk_active() && filter != pdf_filter_flate_decode_name && filter != pdf_filter_flate_short_name { raise FilterNotSupported(filter) }"
