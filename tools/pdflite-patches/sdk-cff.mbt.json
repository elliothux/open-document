        "///|",
        "/// Bounded CFF outlines in normalized em coordinates, without font substitution.",
        "pub(all) enum SdkCffSegment {",
        "  CffMove(Double, Double)",
        "  CffLine(Double, Double)",
        "  CffCubic(Double, Double, Double, Double, Double, Double)",
        "  CffClose",
        "}",
        "",
        "///|",
        "pub struct SdkCffFont {",
        "  font : @cffparser.CffFontRef",
        "  names : Map[String, Int]",
        "  codes : Map[Int, Int]",
        "  encoded : Array[(Int, @core.PdfName)]",
        "  use_codes : Bool",
        "  paths : Map[Int, Array[SdkCffSegment]]",
        "}",
        "",
        "///|",
        "priv struct SdkCffPen {",
        "  segments : Array[SdkCffSegment]",
        "  upem : Double",
        "  mut valid : Bool",
        "}",
        "",
        "///|",
        "fn SdkCffPen::point(self : SdkCffPen, x : Float, y : Float) -> (Double, Double) {",
        "  let x = x.to_double() / self.upem",
        "  let y = y.to_double() / self.upem",
        "  if x.is_nan() ||",
        "    y.is_nan() ||",
        "    x.is_inf() ||",
        "    y.is_inf() ||",
        "    x.abs() > 1000000 ||",
        "    y.abs() > 1000000 {",
        "    self.valid = false",
        "  }",
        "  (x, y)",
        "}",
        "",
        "///|",
        "fn SdkCffPen::push(self : SdkCffPen, segment : SdkCffSegment) -> Unit {",
        "  if !self.valid {",
        "    return",
        "  }",
        "  if self.segments.length() >= 65536 {",
        "    ignore(@core.sdk_allow(-1))",
        "    self.valid = false",
        "  } else {",
        "    self.segments.push(segment)",
        "  }",
        "}",
        "",
        "///|",
        "impl @read_fonts.OutlinePen for SdkCffPen with fn move_to(self, x, y) {",
        "  let (x, y) = self.point(x, y)",
        "  self.push(CffMove(x, y))",
        "}",
        "",
        "///|",
        "impl @read_fonts.OutlinePen for SdkCffPen with fn line_to(self, x, y) {",
        "  let (x, y) = self.point(x, y)",
        "  self.push(CffLine(x, y))",
        "}",
        "",
        "///|",
        "impl @read_fonts.OutlinePen for SdkCffPen with fn quad_to(self, _, _, _, _) {",
        "  // Type 2 charstrings only emit lines and cubic curves.",
        "  self.valid = false",
        "}",
        "",
        "///|",
        "impl @read_fonts.OutlinePen for SdkCffPen with fn curve_to(",
        "  self,",
        "  x1,",
        "  y1,",
        "  x2,",
        "  y2,",
        "  x,",
        "  y,",
        ") {",
        "  let (x1, y1) = self.point(x1, y1)",
        "  let (x2, y2) = self.point(x2, y2)",
        "  let (x, y) = self.point(x, y)",
        "  self.push(CffCubic(x1, y1, x2, y2, x, y))",
        "}",
        "",
        "///|",
        "impl @read_fonts.OutlinePen for SdkCffPen with fn close(self) {",
        "  self.push(CffClose)",
        "}",
        "",
        "///|",
        "/// Read a single CFF1 font. Implicit simple encodings come from the font program.",
        "pub fn SdkCffFont::new(",
        "  bytes : Bytes,",
        "  cid : Bool,",
        "  implicit : Bool,",
        ") -> SdkCffFont raise @core.PdfError {",
        "  guard @core.sdk_active() else {",
        "    raise @core.PdfError::HardError(\"CFF reads require an active SDK budget\")",
        "  }",
        "  guard bytes.length() <= 33554432 else {",
        "    raise @core.PdfError::HardError(\"CFF font exceeds byte limit\")",
        "  }",
        "  let font = try {",
        "    if bytes.length() >= 4 && bytes[0:4] == b\"OTTO\" {",
        "      let face = @read_fonts.FontRef::new(bytes[:])",
        "      let upem = face.head().units_per_em()",
        "      guard upem >= 16 && upem <= 16384 else {",
        "        raise @core.PdfError::HardError(\"Invalid OpenType CFF units per em\")",
        "      }",
        "      @cffparser.CffFontRef::new_cff(face.cff().offset_data(), 0, Some(upem))",
        "    } else {",
        "      @cffparser.CffFontRef::new_cff(bytes[:], 0, None)",
        "    }",
        "  } catch {",
        "    error =>",
        "      raise @core.PdfError::HardError(\"Invalid CFF font: \" + error.to_string())",
        "  }",
        "  let count = font.num_glyphs()",
        "  guard font.is_cid() == cid &&",
        "    count > 0 &&",
        "    count <= 65535 &&",
        "    font.upem() > 0 &&",
        "    font.num_subfonts() > 0 &&",
        "    font.num_subfonts() <= 256 else {",
        "    raise @core.PdfError::HardError(\"Invalid CFF font geometry or keying\")",
        "  }",
        "  guard font.charset() is Some(charset) else {",
        "    raise @core.PdfError::HardError(\"Missing CFF charset\")",
        "  }",
        "  let names : Map[String, Int] = Map([])",
        "  let codes : Map[Int, Int] = Map([])",
        "  let glyph_names = Array::make(count, \"\")",
        "  let mut entries = 0",
        "  for (glyph, sid) in charset.iter() {",
        "    @core.sdk_check(1)",
        "    let gid = glyph.to_int()",
        "    guard gid >= 0 && gid < count else {",
        "      raise @core.PdfError::HardError(\"Invalid CFF glyph identifier\")",
        "    }",
        "    if cid {",
        "      codes[sid.to_u16()] = gid",
        "    } else {",
        "      guard font.string(sid) is Some(name) &&",
        "        name.length() <= 256 &&",
        "        name.iter().all(byte => byte.to_int() >= 33 && byte.to_int() <= 126) else {",
        "        raise @core.PdfError::HardError(\"Invalid CFF glyph name\")",
        "      }",
        "      let name = @ascii.decode_lossy(name)",
        "      names[name] = gid",
        "      glyph_names[gid] = name",
        "    }",
        "    entries += 1",
        "  }",
        "  guard entries == count else {",
        "    raise @core.PdfError::HardError(\"Truncated CFF charset\")",
        "  }",
        "  let encoded : Array[(Int, @core.PdfName)] = []",
        "  if implicit && !cid {",
        "    guard font.encoding() is Some(encoding) else {",
        "      raise @core.PdfError::HardError(\"Missing CFF encoding\")",
        "    }",
        "    for code in 0..<256 {",
        "      // Charset lookup is linear; charge its bounded worst-case work.",
        "      @core.sdk_check(count)",
        "      if encoding.map(code.to_byte()) is Some(glyph) {",
        "        let gid = glyph.to_int()",
        "        guard gid >= 0 && gid < count else {",
        "          raise @core.PdfError::HardError(\"Invalid CFF encoded glyph\")",
        "        }",
        "        codes[code] = gid",
        "        encoded.push(",
        "          (code, @core.pdf_name_of_bytes(@utf8.encode(\"/\" + glyph_names[gid]))),",
        "        )",
        "      }",
        "    }",
        "  }",
        "  { font, names, codes, encoded, use_codes: cid || implicit, paths: Map([]), }",
        "}",
        "",
        "///|",
        "pub fn SdkCffFont::encoding(self : SdkCffFont) -> Array[(Int, @core.PdfName)] {",
        "  self.encoded.copy()",
        "}",
        "",
        "///|",
        "/// Resolve the PDF encoding or CID charset and execute one bounded charstring.",
        "pub fn SdkCffFont::outline(",
        "  self : SdkCffFont,",
        "  code : Int,",
        "  name : String,",
        ") -> Array[SdkCffSegment] raise @core.PdfError {",
        "  guard @core.sdk_active() else {",
        "    raise @core.PdfError::HardError(\"CFF reads require an active SDK budget\")",
        "  }",
        "  let glyph = if self.use_codes {",
        "    self.codes.get(code)",
        "  } else {",
        "    self.names.get(name)",
        "  }",
        "  guard glyph is Some(gid) else {",
        "    raise @core.PdfError::HardError(\"Missing embedded CFF glyph\")",
        "  }",
        "  if self.paths.get(gid) is Some(path) {",
        "    return path",
        "  }",
        "  let glyph = @font_types.GlyphId::from_int(gid)",
        "  let pen : SdkCffPen = {",
        "    segments: [],",
        "    upem: self.font.upem().to_double(),",
        "    valid: true,",
        "  }",
        "  try {",
        "    guard self.font.subfont_index(glyph) is Some(index) else {",
        "      raise @core.PdfError::HardError(\"Missing CFF subfont\")",
        "    }",
        "    let subfont = self.font.subfont(index, [])",
        "    ignore(self.font.draw(subfont, glyph, [], None, pen))",
        "  } catch {",
        "    error => {",
        "      @core.sdk_check(0)",
        "      raise @core.PdfError::HardError(\"Invalid CFF glyph: \" + error.to_string())",
        "    }",
        "  }",
        "  guard pen.valid else {",
        "    raise @core.PdfError::HardError(",
        "      \"CFF outline exceeds coordinate or segment limit\",",
        "    )",
        "  }",
        "  @core.sdk_decoded(pen.segments.length() * 48)",
        "  self.paths[gid] = pen.segments",
        "  pen.segments",
        "}"
      ]
    ]
  ]
}
