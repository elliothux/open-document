    ("formats/src/pdf", "PageOperationCount", "pdfPageOperationCount"),
    ("formats/src/pdf", "RedactionRegionCount", "pdfRedactionRegionCount"),
    ("formats/src/xlsx", "CellFragmentCells", "xlsxCellFragmentCells"),
    ("formats/src/xlsx", "ChartReferenceUnits", "xlsxChartReferenceUnits"),
    ("formats/src/xlsx", "ChartSeriesCount", "xlsxChartSeriesCount"),
    (
      "formats/src/xlsx", "DrawingDescriptionUnits", "xlsxDrawingDescriptionUnits",
    ),
    ("formats/src/xlsx", "DrawingNameUnits", "xlsxDrawingNameUnits"),
    ("formats/src/xlsx", "ShapeFontUnits", "xlsxShapeFontUnits"),
    ("formats/src/xlsx", "ShapeTextUnits", "xlsxShapeTextUnits"),
    ("formats/src/xlsx", "CellFragmentMerges", "xlsxCellFragmentMerges"),
    ("formats/src/xlsx", "CellFragmentTextUnits", "xlsxCellFragmentTextUnits"),
