    ("formats/src/xlsx", "AxisEditCount", "xlsxAxisEditCount"),
    ("formats/src/xlsx", "DateSeriesStepMax", "xlsxDateSeriesStepMax"),
    ("formats/src/xlsx", "DefinedNameUnits", "xlsxDefinedNameUnits"),
    ("formats/src/xlsx", "PrintSheetLimit", "xlsxPrintSheetLimit"),
    ("formats/src/xlsx", "PrintPaperMinPoints", "xlsxPrintPaperMinPoints"),
    ("formats/src/xlsx", "PrintPageMaxPoints", "xlsxPrintPageMaxPoints"),
    ("formats/src/xlsx", "PrintScaleMin", "xlsxPrintScaleMin"),
    ("formats/src/xlsx", "PrintScaleMax", "xlsxPrintScaleMax"),
    ("formats/src/xlsx", "PrintFitPageCount", "xlsxPrintFitPageCount"),
    ("formats/src/xlsx", "PrintAreaUnits", "xlsxPrintAreaUnits"),
    ("formats/src/xlsx", "PrintTitleUnits", "xlsxPrintTitleUnits"),
    ("formats/src/xlsx", "HeaderFooterTextUnits", "xlsxHeaderFooterTextUnits"),
    ("formats/src/xlsx", "CellTextUnits", "xlsxCellTextUnits"),
    ("formats/src/xlsx", "FormulaSourceUnits", "xlsxFormulaSourceUnits"),
    ("formats/src/xlsx", "ConditionalRangeUnits", "xlsxConditionalRangeUnits"),
    ("formats/src/xlsx", "ConditionalTextUnits", "xlsxConditionalTextUnits"),
    ("formats/src/xlsx", "ConditionalRuleCount", "xlsxConditionalRuleCount"),
    ("formats/src/xlsx", "ValidationFormulaUnits", "xlsxValidationFormulaUnits"),
    ("formats/src/xlsx", "ValidationTitleUnits", "xlsxValidationTitleUnits"),
    ("formats/src/xlsx", "ValidationMessageUnits", "xlsxValidationMessageUnits"),
    ("formats/src/xlsx", "PivotSourceColumns", "xlsxPivotSourceColumns"),
    ("formats/src/xlsx", "PivotSourceCells", "xlsxPivotSourceCells"),
    ("formats/src/xlsx", "PivotFieldsPerRole", "xlsxPivotFieldsPerRole"),
    ("formats/src/xlsx", "PivotSubtotalFields", "xlsxPivotSubtotalFields"),
    ("formats/src/xlsx", "PivotGroupUnits", "xlsxPivotGroupUnits"),
    ("formats/src/xlsx", "PivotDateUnits", "xlsxPivotDateUnitCount"),
    ("formats/src/xlsx", "PivotMembers", "xlsxPivotMembers"),
    ("formats/src/xlsx", "PivotFilterUnits", "xlsxPivotFilterUnits"),
    ("formats/src/xlsx", "PivotValueNameUnits", "xlsxPivotValueNameUnits"),
    ("formats/src/xlsx", "SlicerMembers", "xlsxSlicerMembers"),
    ("formats/src/xlsx", "ConsolidationSources", "xlsxConsolidationSources"),
    (
      "formats/src/xlsx", "ConsolidationSourceCells", "xlsxConsolidationSourceCells",
    ),
    ("formats/src/xlsx", "DuplicateCells", "xlsxDuplicateCells"),
    ("formats/src/xlsx", "SubtotalCells", "xlsxSubtotalCells"),
    ("formats/src/xlsx", "TextColumnCells", "xlsxTextColumnCells"),
    (
      "formats/src/xlsx", "TextColumnBreakPosition", "xlsxTextColumnBreakPosition",
    ),
    ("formats/src/xlsx", "SortKeys", "xlsxSortKeys"),
    ("formats/src/xlsx", "SortListLabels", "xlsxSortListLabels"),
    ("formats/src/xlsx", "SortListUnits", "xlsxSortListUnits"),
    ("formats/src/xlsx", "FilterColumns", "xlsxFilterColumns"),
    ("formats/src/xlsx", "FilterEntries", "xlsxFilterEntries"),
    ("formats/src/xlsx", "FilterLabelUnits", "xlsxFilterLabelUnits"),
    ("formats/src/xlsx", "FilterTextUnits", "xlsxFilterTextUnits"),
    ("formats/src/xlsx", "TableStyleRegions", "xlsxTableStyleRegionCount"),
    ("formats/src/xlsx", "TableStyleStripeSize", "xlsxTableStyleStripeSize"),
    ("layout/src", "ImageBytes", "imageBytes"),
    ("layout/src", "ImageDimension", "imageDimension"),
    ("layout/src", "TabStopCount", "tabStopCount"),
    ("layout/src", "GradientStopCount", "gradientStopCount"),
    ("layout/src", "TileReplayWork", "tileReplayWork"),
    ("layout/src", "MathTextUnits", "mathTextUnits"),
    ("layout/src", "MathFontUnits", "mathFontUnits"),
    ("layout/src", "PageColumnCount", "docxPageColumnCount"),
    ("layout/src", "PageBorderSideCount", "docxPageBorderSideCount"),
    ("layout/src", "NumberingStartMax", "docxNumberingStartMax"),
    ("formats/src/internal/omml", "LatexSourceUnits", "latexSourceUnits"),
  ]
  let limit_exports = StringBuilder()
  let limit_types = StringBuilder()
  for (package_path, name, exported) in limits {
    let value = engine_limit(package_path, name)
    limit_exports.write_string("export const \{exported} = \{value};\n")
    limit_types.write_string("export declare const \{exported}: number;\n")
  }
  let artifacts : Map[String, Bytes] = Map([])
  let identities : Map[String, String] = Map([])
  for format in ["all", "docx", "xlsx", "pptx", "pdf"] {
    let wasm = optimized_engine(format)
    let name = if format == "all" { "engine" } else { format }
    artifacts[name] = wasm
    identities[format] = engine_identity(wasm)
  }
  for name in ["wasm", "web-core", "ui", "docx", "xlsx", "pptx", "pdf"] {
    if @fs.exists("packages/" + name + "/dist") {
      @shell.Cmd("find", ["packages/" + name + "/dist", "-depth", "-delete"])
      .output()
      .check()
    }
  }
  @shell.Cmd("mkdir", ["-p", "packages/wasm/dist"]).output().check()
  for name, wasm in artifacts {
    @fs.write_file("packages/wasm/dist/" + name + ".wasm", wasm)
  }
  @fs.write_file(
    "packages/wasm/dist/engine-source.js",
    "export const engineBuildIds = Object.freeze(" +
    Json(identities).stringify() +
    ");\n" +
    "export const engineBuildId = engineBuildIds.all;\n" +
    limit_exports.to_string(),
  )
  @fs.write_file(
    "packages/wasm/dist/engine-source.d.ts",
    "export declare const engineBuildIds: Readonly<Record<\"all\" | \"docx\" | \"xlsx\" | \"pptx\" | \"pdf\", string>>;\n" +
    "export declare const engineBuildId: string;\n" +
    limit_types.to_string(),
  )
  @shell.Cmd("bun", [
    "x", "tailwindcss", "-i", "packages/ui/src/styles/ui.css", "-o", "packages/ui/dist/styles.css",
    "--minify",
  ])
  .output()
  .check()
  @fs.write_file(
    "packages/ui/dist/styles.js",
    "export default " +
    Json(@fs.read_file("packages/ui/dist/styles.css").text()).stringify() +
    ";\n",
  )
  @fs.write_file(
    "packages/ui/dist/styles.d.ts", "declare const css: string;\nexport default css;\n",
  )
  for name in ["wasm", "web-core", "ui", "docx", "xlsx", "pptx", "pdf"] {
    let root = "packages/" + name
    let files : Array[String] = []
    @fs.walk(root + "/src", (directory, entries) => {
      for entry in entries {
        if (entry.has_suffix(".ts") || entry.has_suffix(".tsx")) &&
          !entry.has_suffix(".d.ts") {
          files.push(directory + "/" + entry)
        }
      }
    })
    guard files.length() > 0 else { fail("Package has no source: " + name) }
    @shell.Cmd(
      "bun",
      [
        "build",
        ..files,
        "--no-bundle",
        "--target",
        "browser",
        "--root",
        root + "/src",
        "--outdir",
        root + "/dist",
      ],
    )
    .output()
    .check()
    if ["docx", "xlsx", "pptx", "pdf"].contains(name) {
      @shell.Cmd("bun", [
        "build",
        root + "/src/worker/index.ts",
        "--target",
        "browser",
        "--outfile",
        root + "/dist/worker/index.js",
      ])
      .output()
      .check()
    }
    @shell.Cmd("bun", [
      "x",
      "tsc",
      "--project",
      root + "/tsconfig.json",
      "--declaration",
      "--emitDeclarationOnly",
      "--noEmit",
      "false",
      "--rootDir",
      root + "/src",
      "--outDir",
      root + "/dist/types",
    ])
    .output()
    .check()
    @shell.Cmd("cp", ["LICENSE", root + "/dist/LICENSE"]).output().check()
  }
  @shell.Cmd("bun", ["run", "--cwd", "packages/devtools", "build"])
  .output()
  .check()
}
