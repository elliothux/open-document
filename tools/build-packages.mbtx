----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.5/crypto",
}
----

///|
async fn optimized_engine(format : String) -> Bytes {
  let artifact = "_build/wasm-gc/release/build/open_document/bridge/" +
    format +
    "/" +
    format
  // Use Binaryen supplied by the pinned MoonBit toolchain. Size optimization
  // preserves the synchronous core's Chromium instantiation size budget.
  // Restrict optimization to Chromium-supported features used by MoonBit.
  // Enabling every proposal can introduce unsupported exact heap types.
  @shell.Cmd("moon-wasm-opt", [
    artifact + ".wasm",
    "--enable-gc",
    "--enable-reference-types",
    "--enable-multivalue",
    "--enable-bulk-memory",
    "--enable-simd",
    "--enable-nontrapping-float-to-int",
    "-Oz",
    "-o",
    artifact + ".optimized.wasm",
  ])
  .output()
  .check()
  let wasm = @fs.read_file(artifact + ".optimized.wasm").binary()
  guard wasm.length() <= 8 * 1024 * 1024 else {
    fail(
      "\{format} Wasm is \{wasm.length()} bytes and exceeds the 8388608-byte build limit",
    )
  }
  wasm
}

///|
fn engine_identity(wasm : Bytes) -> String {
  let identity = StringBuilder()
  for byte in @crypto.sha256(wasm) {
    identity.write_string(byte.to_int().to_string(radix=16).pad_start(2, '0'))
  }
  identity.to_string()
}

///|
async fn engine_limit(package_path : String, name : String) -> String {
  let path = "modules/" + package_path + "/pkg.generated.mbti"
  let prefix = "pub const " + name + " : "
  let source = @fs.read_file(path).text()
  guard source.split("\n").find_first(line => line.has_prefix(prefix))
    is Some(line) &&
    line.strip_prefix(prefix) is Some(declaration) else {
    fail("Missing generated integer constant: " + name)
  }
  let value = match declaration.strip_prefix("Int32 = ") {
    Some(value) => value
    None => declaration.strip_prefix("Int64 = ").unwrap_or("")
  }
  guard !value.is_empty() &&
    value.iter().all(c => c.is_ascii_digit()) &&
    @string.parse_int64(value) <= 9007199254740991L else {
    fail("Generated constant must be a JavaScript safe integer: " + name)
  }
  value.to_owned()
}

