    [0,0,["// Copyright 2026 Open Document contributors. Apache-2.0.","","///|","pub struct LayoutWork {","  mut remaining : Int","  lookups : Map[(Bool, Int, UInt), (BytesView, Int?, Int)]","}","","///|","pub fn layout_work_budget() -> LayoutWork {","  { remaining: 67108864, lookups: Map([]), }","}","","///|","pub fn LayoutWork::remaining(self : LayoutWork) -> Int {","  self.remaining","}","","///|","pub fn LayoutWork::spend(self : LayoutWork, amount : Int) -> Bool {","  if amount < 0 || amount > self.remaining {","    self.remaining = -1","    return false","  }","  self.remaining -= amount","  true","}","","///|","pub fn LayoutWork::check(self : LayoutWork) -> Result[Unit, OtLayoutError] {","  if self.remaining < 0 {","    Err(WorkLimitExceeded)","  } else {","    Ok(())","  }","}","","///|","pub impl ToJson for LayoutWork with fn to_json(self) {","  Json::object({ \"remaining\": self.remaining.to_json() })","}","","///|","pub impl Show for LayoutWork with fn output(self, logger) {","  logger.write_string(\"{remaining: \")","  Show::output(self.remaining, logger)","  logger.write_char('}')","}","","///|","fn LayoutWork::cached(","  self : LayoutWork,","  data : BytesView,","  class_query : Bool,","  offset : Int,","  glyph : UInt,",") -> (Int?, Int)? {","  if self.lookups.get((class_query, offset, glyph)) is Some((source, value, cost)) &&","    physical_equal(source, data) {","    Some((value, cost))","  } else {","    None","  }","}","","///|","fn LayoutWork::remember(","  self : LayoutWork,","  data : BytesView,","  class_query : Bool,","  offset : Int,","  glyph : UInt,","  value : Int?,","  cost : Int,",") -> Unit {","  let key = (class_query, offset, glyph)","  // Retain immutable views only for this bounded shaping call.","  if self.lookups.length() < 128 || self.lookups.contains(key) {","    self.lookups[key] = (data, value, cost)","  }","}"]]
