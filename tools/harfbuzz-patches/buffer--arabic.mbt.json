    [122,0,["  // Match HarfBuzz joining: context changes actions without adding glyphs.","  if buffer.text_context is Some((chars, start, _)) {","    for i = start - 1; i >= (start - 5).max(0); i = i - 1 {","      if !buffer.layout_work.spend(1) {","        return buffer.layout_work.check().map(_ => actions)","      }","      let joining = @unicode.arabic_joining_type(chars[i].to_uint())","      if joining == @unicode.arabic_joining_type_t {","        continue","      }","      let col = joining.reinterpret_as_int()","      if col >= 0 && col < 6 {","        state = arabic_state_table[state][col].next_state","      }","      break","    }","  }"]],
    [141,1,["  if buffer.text_context is Some((chars, _, end)) {","    for i in end..<(end + 5).min(chars.length()) {","      if !buffer.layout_work.spend(1) {","        return buffer.layout_work.check().map(_ => actions)","      }","      let joining = @unicode.arabic_joining_type(chars[i].to_uint())","      if joining == @unicode.arabic_joining_type_t {","        continue","      }","      let col = joining.reinterpret_as_int()","      if col >= 0 && col < 6 && prev >= 0 {","        let entry = arabic_state_table[state][col]","        if entry.prev_action != arabic_action_none {","          actions[prev] = entry.prev_action","        }","      }","      break","    }","  }","  Ok(actions)"]],
