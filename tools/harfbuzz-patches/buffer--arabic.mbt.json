    [412,1,["  if self.direction == @common.direction_ltr &&","    (","      self.script == @common.script_arabic ||","      self.script == @common.script_syriac","    ) &&","    self.infos.any(info => {","      let category = @unicode.general_category(info.unicode)","      category >= @unicode.gc_lowercase_letter &&","      category <= @unicode.gc_uppercase_letter","    }) {","    let context = self.text_context","    let cost = self.infos.length() +","      context.map(value => value.0.length()).unwrap_or(0)","    if !self.layout_work.spend(cost) {","      return self.layout_work.check().map_err(error => Layout(error))","    }","    // Shape in the script's native direction without reversing a grapheme.","    let reversed : Array[GlyphInfo] = []","    let mut end = self.infos.length()","    while end > 0 {","      let mut start = end - 1","      while start > 0 &&","            self.infos[start - 1].cluster == self.infos[end - 1].cluster {","        start -= 1","      }","      for i in start..<end {","        reversed.push(self.infos[i])","      }","      end = start","    }","    self.infos = reversed","    self.direction = @common.direction_rtl","    if context is Some((chars, start, end)) {","      self.text_context = Some(","        (chars.rev()[:], chars.length() - end, chars.length() - start),","      )","    }","    let result = self.shape_arabic(font)","    self.infos.rev_in_place()","    self.positions.rev_in_place()","    self.direction = @common.direction_ltr","    self.text_context = context","    return result","  }","  let actions = match arabic_joining_actions(self) {","    Ok(value) => value","    Err(error) => return Err(Layout(error))","  }"]],
